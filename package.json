{
  "name": "panodash",
  "private": true,
  "version": "0.7.1",
  "description": "A local-first, extensible metrics dashboard that replaces your new tab page.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @panodash/extension",
    "build": "npm run typecheck && npm run build --workspace @panodash/extension && node scripts/extension-build-notice.mjs",
    "build:extension": "npm run build --workspace @panodash/extension",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "bridge": "npm run start --workspace @panodash/bridge",
    "icons": "npm run icons --workspace @panodash/extension",
    "lockups": "node scripts/make-lockups.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.6.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
